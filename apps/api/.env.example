# API environment — PLACEHOLDERS ONLY. Never put a real secret here.
# Copy to .env (gitignored) for local development.

# Required. Local example shape only — use a database you own.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/littleplace_dev
# Comma-separated frontend origins allowed with credentials (dev default below).
FRONTEND_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development
# Storage backend for 1A: "local" is DEV ONLY. Production provider is
# UNDECIDED (R2). Any other value fails fast at startup.
STORAGE_BACKEND=local
# Directory used ONLY by the dev-only local storage backend.
STORAGE_DIR=./storage-dev
# PROPOSED, UNDECIDED (R12): session lifetimes in days.
SESSION_ABSOLUTE_DAYS=30
SESSION_IDLE_DAYS=7
# PROPOSED, UNDECIDED (R7): restore window in days.
RESTORE_WINDOW_DAYS=30
# PROPOSED, UNDECIDED (R4): invitation expiry in days (long tokens only).
INVITE_EXPIRY_DAYS=7
# PROPOSED, UNDECIDED (R13): upload limits in megabytes.
PHOTO_MAX_MB=10
VOICE_MAX_MB=25
