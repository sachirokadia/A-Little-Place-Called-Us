// Phase 1 schema — core plus a minimal, route-less GameProgress model.
// Playable games and board are Phase 1B and are deliberately NOT in
// this schema, and there is NO score endpoint: this model only reserves
// the shape Phase 1B will use, with server-validated progress data.
// Prisma is the sole schema authority; there is no boot-time
// CREATE TABLE and no second migration system.
// CHECK constraints that Prisma cannot express live in the reviewed
// migration SQL under prisma/migrations/ (see that file's header).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LetterVisibility {
  shared
  private_draft
  scheduled
}

enum AppreciationKind {
  appreciation
  achievement
}

enum PlanCategory {
  trip
  date
  meal
  activity
  home
  other
}

enum PlanStatus {
  planned
  done
}

enum ReminderKind {
  note
  prompt
}

enum MediaStatus {
  pending
  active
  soft_deleted
}

enum MediaDeletionStatus {
  pending
  retrying
  failed
  completed
}

model User {
  id           String   @id @default(uuid())
  email        String
  emailLower   String   @unique
  passwordHash String
  displayName  String
  avatarKey    String   @default("bunny")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  memberships  SpaceMember[]
  spacesCreated Space[] @relation("SpaceCreator")
  invitationsCreated Invitation[] @relation("InvitationCreator")
  memories     Memory[]
  letters      Letter[]
  journals     JournalEntry[]
  appreciations Appreciation[]
  plans        FuturePlan[]
  reminders    Reminder[]
  voiceNotes   VoiceNote[]
  favorites    Favorite[]
  auditEvents  AuditEvent[] @relation("AuditActor")
  idempotencyKeys IdempotencyKey[]
  gameProgress GameProgress[]

  @@index([emailLower])
}

model Session {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  csrfTokenHash String
  expiresAt     DateTime
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Space {
  id          String   @id @default(uuid())
  name        String
  createdById String
  createdBy   User     @relation("SpaceCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     SpaceMember[]
  invitations Invitation[]
  memories    Memory[]
  letters     Letter[]
  journals    JournalEntry[]
  appreciations Appreciation[]
  plans       FuturePlan[]
  reminders   Reminder[]
  voiceNotes  VoiceNote[]
  gameProgress GameProgress[]
}

model SpaceMember {
  id       String   @id @default(uuid())
  spaceId  String
  space    Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@unique([spaceId, userId])
  @@unique([userId])
  @@index([spaceId])
}

model Invitation {
  id           String    @id @default(uuid())
  spaceId      String
  space        Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  attemptCount Int       @default(0)
  lockedUntil  DateTime?
  createdById  String
  createdBy    User      @relation("InvitationCreator", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([spaceId, expiresAt])
}

model Memory {
  id         String    @id @default(uuid())
  spaceId    String
  space      Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  title      String
  caption    String    @default("")
  story      String    @default("")
  happenedOn DateTime? @db.Date
  tags       String[]
  sourcePlanId String? @unique
  sourcePlan FuturePlan? @relation("PlanMemory", fields: [sourcePlanId], references: [id])
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  media      MediaAsset[]
  letters    Letter[]

  @@index([spaceId, createdAt(sort: Desc)])
  @@index([spaceId, authorId])
}

model Letter {
  id         String            @id @default(uuid())
  spaceId    String
  space      Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId   String
  author     User              @relation(fields: [authorId], references: [id])
  title      String
  body       String
  visibility LetterVisibility
  revealAt   DateTime?
  memoryId   String?
  memory     Memory?           @relation(fields: [memoryId], references: [id], onDelete: SetNull)
  deletedAt  DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([spaceId, createdAt(sort: Desc)])
  @@index([spaceId, authorId])
}

model JournalEntry {
  id        String    @id @default(uuid())
  spaceId   String
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  title     String
  body      String
  mood      String    @default("")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([spaceId, authorId, createdAt(sort: Desc)])
}

model Appreciation {
  id        String           @id @default(uuid())
  spaceId   String
  space     Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id])
  text      String
  kind      AppreciationKind
  forName   String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId, createdAt(sort: Desc)])
  @@index([spaceId, authorId])
}

model FuturePlan {
  id              String       @id @default(uuid())
  spaceId         String
  space           Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId        String
  author          User         @relation(fields: [authorId], references: [id])
  title           String
  detail          String       @default("")
  category        PlanCategory
  status          PlanStatus   @default(planned)
  targetDate      DateTime?    @db.Date
  completedAt     DateTime?
  location        String       @default("")
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  linkedMemory  Memory?      @relation("PlanMemory")
  media         MediaAsset[]

  @@index([spaceId, status, targetDate])
  @@index([spaceId, authorId])
}

model Reminder {
  id        String       @id @default(uuid())
  spaceId   String
  space     Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id])
  text      String
  kind      ReminderKind
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId, createdAt(sort: Desc)])
}

model VoiceNote {
  id        String    @id @default(uuid())
  spaceId   String
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  title     String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media     MediaAsset[]
}

model MediaAsset {
  id              String      @id @default(uuid())
  ownerId         String
  memoryId        String?
  memory          Memory?     @relation(fields: [memoryId], references: [id], onDelete: SetNull)
  planId          String?
  plan            FuturePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  voiceNoteId     String?
  voiceNote       VoiceNote?  @relation(fields: [voiceNoteId], references: [id], onDelete: SetNull)
  status          MediaStatus @default(active)
  storageKey      String      @unique
  mimeType        String
  byteSize        Int
  width           Int?
  height          Int?
  originalFilename String     @default("")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([memoryId])
  @@index([planId])
  @@index([voiceNoteId])
}

model MediaDeletionJob {
  id           String               @id @default(uuid())
  assetId      String
  storageKey   String
  status       MediaDeletionStatus  @default(pending)
  attempts     Int                  @default(0)
  nextAttemptAt DateTime            @default(now())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, nextAttemptAt])
}

model Favorite {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceType String
  resourceId   String
  createdAt    DateTime @default(now())

  @@unique([userId, resourceType, resourceId])
  @@index([userId, resourceType])
}

model AuditEvent {
  id           String   @id @default(uuid())
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String
  spaceId      String?
  outcome      String
  createdAt    DateTime @default(now())

  @@index([spaceId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}

model RateLimitBucket {
  id          String   @id @default(uuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([key])
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key            String
  requestHash    String
  resourceType   String
  resourceId     String?
  responseStatus Int      @default(201)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([userId, key])
  @@index([userId, expiresAt])
}

// Phase 1B-ready only: no API route reads or writes this model yet,
// and no client score is ever trusted. Progress is opaque JSON that
// Phase 1B server validation will bound and check before storing.
model GameProgress {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  playerId  String
  player    User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameKey   String
  progress  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spaceId, playerId, gameKey])
  @@index([spaceId, playerId])
}
