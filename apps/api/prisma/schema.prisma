// Phase 1 schema — core plus GameProgress, now read and written by
// the Phase 1B game routes (boyfriend arcade, hero adventure, board).
// Prisma is the sole schema authority; there is no boot-time
// CREATE TABLE and no second migration system.
// CHECK constraints that Prisma cannot express live in the reviewed
// migration SQL under prisma/migrations/ (see that file's header).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LetterVisibility {
  shared
  private_draft
  scheduled
}

enum AppreciationKind {
  appreciation
  achievement
}

enum PlanCategory {
  trip
  date
  meal
  activity
  home
  other
}

enum PlanStatus {
  planned
  done
}

enum ReminderKind {
  note
  prompt
}

enum MediaStatus {
  pending
  active
  soft_deleted
}

enum MediaDeletionStatus {
  pending
  retrying
  failed
  completed
}

model User {
  id           String   @id @default(uuid())
  email        String
  emailLower   String   @unique
  passwordHash String
  displayName  String
  avatarKey    String   @default("bunny")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  memberships  SpaceMember[]
  spacesCreated Space[] @relation("SpaceCreator")
  invitationsCreated Invitation[] @relation("InvitationCreator")
  memories     Memory[]
  letters      Letter[]
  journals     JournalEntry[]
  appreciations Appreciation[]
  plans        FuturePlan[]
  reminders    Reminder[]
  voiceNotes   VoiceNote[]
  favorites    Favorite[]
  preference   UserPreference?
  auditEvents  AuditEvent[] @relation("AuditActor")
  idempotencyKeys IdempotencyKey[]
  gameProgress GameProgress[]
  quizQuestions QuizQuestion[]
  heroMissions HeroMission[]
  guessRoundsCreated GuessRound[]
  chestRiddles ChestRiddle[]
  chestSolves ChestSolve[]
  chestRewardsUpdated ChestReward[]
  finalMessagesUpdated FinalMessage[]
  boardConfigs BoardConfig[]
  boardGamesCreated BoardGame[]

  @@index([emailLower])
}

model Session {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  csrfTokenHash String
  expiresAt     DateTime
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Space {
  id          String   @id @default(uuid())
  name        String
  createdById String
  createdBy   User     @relation("SpaceCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     SpaceMember[]
  invitations Invitation[]
  memories    Memory[]
  letters     Letter[]
  journals    JournalEntry[]
  appreciations Appreciation[]
  plans       FuturePlan[]
  reminders   Reminder[]
  voiceNotes  VoiceNote[]
  gameProgress GameProgress[]
  quizQuestions QuizQuestion[]
  heroMissions HeroMission[]
  guessRounds GuessRound[]
  finalMessages FinalMessage[]
  chestRiddles ChestRiddle[]
  chestSolves ChestSolve[]
  chestReward ChestReward?
  boardConfigs BoardConfig[]
  boardGames BoardGame[]
}

model SpaceMember {
  id       String   @id @default(uuid())
  spaceId  String
  space    Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@unique([spaceId, userId])
  @@unique([userId])
  @@index([spaceId])
}

model Invitation {
  id           String    @id @default(uuid())
  spaceId      String
  space        Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  attemptCount Int       @default(0)
  lockedUntil  DateTime?
  createdById  String
  createdBy    User      @relation("InvitationCreator", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([spaceId, expiresAt])
}

model Memory {
  id         String    @id @default(uuid())
  spaceId    String
  space      Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  title      String
  caption    String    @default("")
  story      String    @default("")
  happenedOn DateTime? @db.Date
  tags       String[]
  sourcePlanId String? @unique
  sourcePlan FuturePlan? @relation("PlanMemory", fields: [sourcePlanId], references: [id])
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  media      MediaAsset[]
  letters    Letter[]
  chestRewards ChestReward[]

  @@index([spaceId, createdAt(sort: Desc)])
  @@index([spaceId, authorId])
}

model Letter {
  id         String            @id @default(uuid())
  spaceId    String
  space      Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId   String
  author     User              @relation(fields: [authorId], references: [id])
  title      String
  body       String
  visibility LetterVisibility
  revealAt   DateTime?
  memoryId   String?
  memory     Memory?           @relation(fields: [memoryId], references: [id], onDelete: SetNull)
  deletedAt  DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([spaceId, createdAt(sort: Desc)])
  @@index([spaceId, authorId])
}

model JournalEntry {
  id        String    @id @default(uuid())
  spaceId   String
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  title     String
  body      String
  mood      String    @default("")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([spaceId, authorId, createdAt(sort: Desc)])
}

model Appreciation {
  id        String           @id @default(uuid())
  spaceId   String
  space     Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id])
  text      String
  kind      AppreciationKind
  forName   String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId, createdAt(sort: Desc)])
  @@index([spaceId, authorId])
}

model FuturePlan {
  id              String       @id @default(uuid())
  spaceId         String
  space           Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId        String
  author          User         @relation(fields: [authorId], references: [id])
  title           String
  detail          String       @default("")
  category        PlanCategory
  status          PlanStatus   @default(planned)
  targetDate      DateTime?    @db.Date
  completedAt     DateTime?
  location        String       @default("")
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  linkedMemory  Memory?      @relation("PlanMemory")
  media         MediaAsset[]

  @@index([spaceId, status, targetDate])
  @@index([spaceId, authorId])
}

model Reminder {
  id        String       @id @default(uuid())
  spaceId   String
  space     Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id])
  text      String
  kind      ReminderKind
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId, createdAt(sort: Desc)])
}

model VoiceNote {
  id        String    @id @default(uuid())
  spaceId   String
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  title     String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media     MediaAsset[]
}

model MediaAsset {
  id              String      @id @default(uuid())
  ownerId         String
  memoryId        String?
  memory          Memory?     @relation(fields: [memoryId], references: [id], onDelete: SetNull)
  planId          String?
  plan            FuturePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  voiceNoteId     String?
  voiceNote       VoiceNote?  @relation(fields: [voiceNoteId], references: [id], onDelete: SetNull)
  status          MediaStatus @default(active)
  storageKey      String      @unique
  mimeType        String
  byteSize        Int
  width           Int?
  height          Int?
  originalFilename String     @default("")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([memoryId])
  @@index([planId])
  @@index([voiceNoteId])
}

model MediaDeletionJob {
  id           String               @id @default(uuid())
  assetId      String
  storageKey   String
  status       MediaDeletionStatus  @default(pending)
  attempts     Int                  @default(0)
  nextAttemptAt DateTime            @default(now())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, nextAttemptAt])
}

model Favorite {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceType String
  resourceId   String
  createdAt    DateTime @default(now())

  @@unique([userId, resourceType, resourceId])
  @@index([userId, resourceType])
}

// Phase 5: per-user display preferences. One row per user, always
// scoped to the session caller — there is no endpoint that takes
// another user's id. motion 'system' means the frontend defers to
// the OS prefers-reduced-motion setting; 'reduce' is an explicit
// user override and never silently falls back to full motion.
// soundEnabled defaults OFF.
model UserPreference {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  motion         String   @default("system")
  soundEnabled   Boolean  @default(false)
  onboardingSeen Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditEvent {
  id           String   @id @default(uuid())
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String
  spaceId      String?
  outcome      String
  createdAt    DateTime @default(now())

  @@index([spaceId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}

model RateLimitBucket {
  id          String   @id @default(uuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([key])
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key            String
  requestHash    String
  resourceType   String
  resourceId     String?
  responseStatus Int      @default(201)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([userId, key])
  @@index([userId, expiresAt])
}

// GameProgress model: read and written by the Phase 1B game routes
// (boyfriend arcade, hero adventure, board), with server-validated
// progress data; no client score is ever trusted. Progress is opaque
// JSON that Phase 1B server validation bounds and checks before storing.
model GameProgress {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  playerId  String
  player    User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameKey   String
  progress  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spaceId, playerId, gameKey])
  @@index([spaceId, playerId])
}

// Boyfriend Arcade: quiz questions, guess-the-answer rounds, the
// treasure-chest riddle chain, and the chest reward. All rows are
// space-scoped; the space FK cascades. Answers are never trusted
// from the client on read paths — see routes/boyfriend.ts for the
// masking rules (correctOption and riddle answers are write-only;
// a guess round's answer is shown only to its creator until reveal).
model QuizQuestion {
  id            String   @id @default(uuid())
  spaceId       String
  space         Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  question      String
  options       String[]
  correctOption Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([spaceId, createdAt])
}

model GuessRound {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  creatorId String
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  guesserId String?
  guessText String?
  revealed  Boolean  @default(false)
  correct   Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId, createdAt(sort: Desc)])
}

model ChestRiddle {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sortOrder Int
  question  String
  answer    String
  hint      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solves    ChestSolve[]

  @@index([spaceId, sortOrder])
}

model ChestSolve {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  playerId  String
  player    User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  riddleId  String
  riddle    ChestRiddle @relation(fields: [riddleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([spaceId, playerId, riddleId])
  @@index([spaceId, playerId])
}

// Personalized adventure: missions are shared config for a space,
// like chest riddles — either member may create one, but only the
// author may PATCH or DELETE their own row (partner gets a generic
// 404). A mission carries at most one reward link, validated by
// the route layer against the linked row's space and visibility;
// the link columns are plain ids (no FK) so deleting the linked
// memory/letter/appreciation never cascades into the mission, and
// a mission never carries another user's private content — the
// route only returns the mission's own fields. No official
// property names, assets, or dialogue appear anywhere here; the
// level ids are generic place names chosen for this feature.
model HeroMission {
  id                   String   @id @default(cuid())
  spaceId              String
  space                Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId             String
  author               User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  levelId              String
  title                String
  clue                 String
  rewardMessage        String
  rewardMemoryId       String?
  rewardLetterId       String?
  rewardAppreciationId String?
  order                Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([spaceId, levelId])
}

model ChestReward {
  id         String   @id @default(uuid())
  spaceId    String   @unique
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  message    String
  memoryId   String?
  memory     Memory?  @relation(fields: [memoryId], references: [id], onDelete: SetNull)
  updatedById String
  updatedBy  User     @relation(fields: [updatedById], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Personalisation: the two shared final messages (the arcade's
// final star letter and the hero adventure's final message). These
// are SHARED config, like the chest reward: either space member may
// read and overwrite them; there is no author-only restriction.
// `kind` is 'star-letter' | 'hero-final' (enforced by a CHECK in
// the migration). When no row exists, the frontend falls back to
// the code drafts, still labelled as drafts.
model FinalMessage {
  id          String   @id @default(uuid())
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  kind        String
  text        String
  updatedById String
  updatedBy   User     @relation(fields: [updatedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([spaceId, kind])
  @@index([spaceId])
}

// Phase 7: original relationship board game (custom terminology
// only: Memory Coins, Plot Twists, Little Surprises, Places and
// Moments, tokens — no third-party board-game name, logo, or card
// text appears anywhere here).
//
// BoardConfig is shared configuration for a space: ANY space
// member may read it, either member may create one, and only the
// AUTHOR may PATCH or DELETE their own row (a partner gets a
// generic 404, following the hero-router pattern). The default
// config is seeded per space on first GET if none exists (see
// routes/board.ts); it is an ordinary row, not special-cased
// afterwards. The `config` column holds the full BoardConfigData
// JSON; its shape is owned by the shared board engine and is
// validated by the route layer (zod shape checks plus a trial
// createGame call) at CREATE/PATCH time, so GET trusts stored JSON.
//
// BoardGame is one running game. `configId` is a PLAIN id, NOT a
// foreign key: deleting a config must never delete a running
// game. `configSnapshot` is the full BoardConfigData copied at
// creation, so mid-game config edits cannot affect a running
// game. `state` is the full GameState JSON, owned by the engine;
// the route never trusts client-supplied state. `version` is
// optimistic locking: it starts at 1 and increments on every
// accepted action; an action whose expectedVersion does not match
// is rejected with 409 STALE_VERSION. `status` is 'playing' or
// 'finished'. Games are local two-player on one device: both
// space members share the device and the game, so either member
// may read a game and post actions to it; the "actor" is the
// in-game player index 0/1, NOT the account.
model BoardConfig {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name      String
  config    Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId, createdAt])
}

model BoardGame {
  id             String   @id @default(uuid())
  spaceId        String
  space          Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  configId       String
  configSnapshot Json
  state          Json
  version        Int      @default(1)
  status         String   @default("playing")
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([spaceId, createdAt])
}
