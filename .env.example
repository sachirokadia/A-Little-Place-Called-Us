# Frontend: choose ONE backend. PostgreSQL API mode (recommended, plain PostgreSQL):
VITE_API_URL=http://localhost:4000
# — or Supabase mode (leave VITE_API_URL unset and set these two instead) —
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key
# With neither set, the app runs in labelled demo mode (localStorage only).
# NEVER put a service-role key, DATABASE_URL, or JWT_SECRET in a VITE_ variable.
