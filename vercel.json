{
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "apps/frontend/dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index?__path=:path*"
    },
    {
      "destination": "/index.html",
      "source": "/login"
    },
    {
      "destination": "/index.html",
      "source": "/register"
    },
    {
      "destination": "/index.html",
      "source": "/welcome"
    },
    {
      "destination": "/index.html",
      "source": "/space"
    },
    {
      "destination": "/index.html",
      "source": "/memories"
    },
    {
      "destination": "/index.html",
      "source": "/letters"
    },
    {
      "destination": "/index.html",
      "source": "/quiet"
    },
    {
      "destination": "/index.html",
      "source": "/appreciations"
    },
    {
      "destination": "/index.html",
      "source": "/appreciations/favourites"
    },
    {
      "destination": "/index.html",
      "source": "/future"
    },
    {
      "destination": "/index.html",
      "source": "/reminders"
    },
    {
      "destination": "/index.html",
      "source": "/arcade"
    },
    {
      "destination": "/index.html",
      "source": "/deleted"
    },
    {
      "destination": "/index.html",
      "source": "/settings"
    }
  ]
}
